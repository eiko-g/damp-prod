# ===== 通用 =====
# 容器时区
TZ=Asia/Shanghai
# Docker 日志轮转，防止小硬盘被日志吃满
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ===== 数据库账号 =====
MARIADB_DATABASE=dbname
MARIADB_USER=dbuser
MARIADB_PASSWORD=your_secure_password_here
MARIADB_ROOT_PASSWORD=your_secure_root_password_here

# 只允许本机连数据库就用 127.0.0.1；要外部直连改成 0.0.0.0（记得配防火墙）
MARIADB_BIND_IP=127.0.0.1
MARIADB_PORT=3306

# ===== MariaDB 调参（下面是 2C2G 的默认值） =====
# 容器资源上限
DB_CPUS=1.0
DB_MEM_LIMIT=900m
# 缓冲池：2G 内存给 384M 比较稳；数据量很小可以降到 256M
DB_INNODB_BUFFER_POOL_SIZE=384M
DB_INNODB_LOG_FILE_SIZE=64M
DB_INNODB_LOG_BUFFER_SIZE=16M
# 1=最安全（每次提交都刷盘），2=更快，但断电可能丢约 1 秒事务
DB_INNODB_FLUSH_LOG_AT_TRX_COMMIT=1
DB_INNODB_IO_CAPACITY=200
DB_MAX_CONNECTIONS=50
DB_TABLE_OPEN_CACHE=400
DB_TABLE_DEFINITION_CACHE=400
DB_TMP_TABLE_SIZE=32M
DB_MAX_HEAP_TABLE_SIZE=32M
DB_KEY_BUFFER_SIZE=16M
# performance_schema 很占内存，小机器关掉
DB_PERFORMANCE_SCHEMA=OFF
DB_SLOW_QUERY_LOG=ON
DB_LONG_QUERY_TIME=2

# ===== PHP（构建期参数，改完要 docker compose build） =====
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M
PHP_TIMEZONE=Asia/Shanghai
PHP_OPCACHE_MEMORY=128M
PHP_OPCACHE_MAX_FILES=10000
# 1=按 PHP_OPCACHE_REVALIDATE_FREQ 秒检查文件改动；直接挂载目录改代码要留着 1
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_REVALIDATE_FREQ=2
# JIT：纯 PHP 计算多的站可以试 tracing + 32M（两个一起设），一般 Web 应用保持 off
PHP_OPCACHE_JIT=off
PHP_OPCACHE_JIT_BUFFER_SIZE=0

# ===== Apache / www（构建期参数，改完要 docker compose build） =====
WWW_CPUS=1.5
WWW_MEM_LIMIT=768m
# 并发 worker 数≈同时处理的请求数；2G 内存下 20 左右，吃紧就再往下调
APACHE_MAX_REQUEST_WORKERS=20
APACHE_START_SERVERS=5
APACHE_MIN_SPARE_SERVERS=5
APACHE_MAX_SPARE_SERVERS=8
# 长连接空闲超时（秒），调小能更快释放 worker
APACHE_KEEPALIVE_TIMEOUT=3
APACHE_MAX_KEEPALIVE_REQUESTS=100

# ===== 端口 =====
APACHE_PORT=80
APACHE_PORT_SSL=443

# ===== PHPMyAdmin（默认注释掉，要用再开） =====
# PMA_HOST=db
# PMA_USER=root
# PMA_PASSWORD=your_secure_root_password_here
# PHPMYADMIN_PORT=8086